    // ── Helpers ───────────────────────────────────────────────────────────────

    private EndpointDTO ep(String method, String path, String desc, List<ParamDTO> params) {
        return new EndpointDTO(method, path, desc, params);
    }

    private List<ParamDTO> path(String name, String placeholder) {
        return Collections.singletonList(new ParamDTO(name, "path", true, placeholder));
    }

    private List<ParamDTO> body(String placeholder) {
        return Collections.singletonList(bodyParam(placeholder));
    }

    private ParamDTO bodyParam(String placeholder) {
        return new ParamDTO("body", "body", true, placeholder);
    }
